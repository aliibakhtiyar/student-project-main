# Local example only. Set production values in Render -> Backend service -> Environment.
# Never commit real API keys, passwords, or database connection strings.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/unisphere_staging
JWT_SECRET=replace-with-a-long-random-secret

# Groq CLOUD free tier (not Grok, xAI or grok-api.com).
# Get your own key at https://console.groq.com/keys
GROQ_API_KEY=replace-with-your-groq-cloud-api-key
GROQ_CHAT_MODEL=openai/gpt-oss-120b

FRONTEND_URL=http://localhost:5173

# Keep any other existing email, Google, GitHub and LinkedIn variables.
# VITE_API_URL belongs to the FRONTEND Render service, not the backend.
